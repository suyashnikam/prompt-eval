# Copy this file to .env and fill in ONE of the two options below.
# .env is git-ignored, so your real values never get committed.

# Option A — Anthropic API (get a key at https://console.anthropic.com)
ANTHROPIC_API_KEY=your-api-key-here

# Option B — Claude on Amazon Bedrock (used automatically when ANTHROPIC_API_KEY is not set)
# Delete the ANTHROPIC_API_KEY line above, then uncomment these:
# AWS_REGION=us-east-1
# AWS_PROFILE=your-aws-profile   # only needed if you don't use the default AWS profile
